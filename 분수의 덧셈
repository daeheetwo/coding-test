def solution(numer1, denom1, numer2, denom2):

    a = numer1 * denom2 + numer2 * denom1
    b = denom1 * denom2
    
    for i in range(2,1000):
        for j in range(2,1000):
            if (a % j == 0) and (b % j == 0):
                a = a / j
                b = b / j
    
    answer = [a,b]
    return answer
